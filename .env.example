# Copy to .env for local runs:  cp .env.example .env
# On the cloud VM this file is created automatically with a random password.

# ":80" = plain HTTP locally. On the VM: retailflow.<ip>.sslip.io (automatic HTTPS)
SITE_ADDRESS=:80
POSTGRES_PASSWORD=change-me-postgres

# Which image to run (the pipeline sets these when it deploys)
IMAGE=ghcr.io/shivamcp18/retailflow
TAG=latest
